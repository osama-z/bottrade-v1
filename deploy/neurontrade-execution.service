[Unit]
Description=NeuronTrade Execution Node (risk, orders, kill switch, Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust user and paths for your host
User=osama
WorkingDirectory=/home/osama/ai-workspace/projects/neurontrade
ExecStart=/home/osama/ai-workspace/projects/neurontrade/.venv/bin/python scripts/run_decoupled_execution.py
Restart=on-failure
RestartSec=10
# SIGTERM → flags only; the node finishes in-flight position writes
# (scheduler.shutdown(wait=True)) before exiting.
TimeoutStopSec=120
KillSignal=SIGTERM

# The kill switch (SIGUSR1 / KILL_SWITCH flag file) remains available:
#   systemctl kill -s SIGUSR1 neurontrade-execution
#   touch /home/osama/ai-workspace/projects/neurontrade/KILL_SWITCH

# Hardening. ProtectSystem=strict makes /usr, /etc, /boot read-only to
# the service; only the project dir is writable (the bot legitimately
# writes there: SQLite state, logs, model retrains, and the KILL_SWITCH
# flag file at the project root). A compromised dependency can therefore
# touch bot state but not the OS, other users' homes, or systemd units.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/osama/ai-workspace/projects/neurontrade
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
