[Unit]
Description=NeuronTrade Intelligence Node (signal generation, ZMQ publisher)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Render placeholders with setup_server.sh
User=@RUN_USER@
WorkingDirectory=@PROJECT_ROOT@
ExecStart=@PROJECT_ROOT@/.venv/bin/python scripts/run_decoupled_intelligence.py
Restart=on-failure
RestartSec=10
# SIGTERM → cooperative shutdown; give in-flight work time to finish
TimeoutStopSec=60
KillSignal=SIGTERM

# Hardening. ProtectSystem=strict makes /usr, /etc, /boot read-only to
# the service; only the project dir is writable (the bot legitimately
# writes there: SQLite state, logs, model retrains, and the KILL_SWITCH
# flag file at the project root). A compromised dependency can therefore
# touch bot state but not the OS, other users' homes, or systemd units.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@PROJECT_ROOT@
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
