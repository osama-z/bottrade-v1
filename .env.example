# ═══════════════════════════════════════════
# Public demo: exchange keys are not needed; leave blank.
# ═══════════════════════════════════════════
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ═══════════════════════════════════════════
# Optional AI research — Groq API
# ═══════════════════════════════════════════
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_ANALYSIS_INTERVAL=300

# ═══════════════════════════════════════════
# Optional Telegram alerts/control
# ═══════════════════════════════════════════
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ═══════════════════════════════════════════
# Trading
# ═══════════════════════════════════════════
# Which pairs to trade (USDT quote only — equity/risk are USDT-denominated).
# PAPER-RUN CONFIG (measured, docs/STRATEGY_NOTES.md): the strategy-lab
# candidate is trend_following on 4h over the pairs it screened positive
# on. 1h was measured and abandoned (fees + noise). ai_combined needs
# trained models per pair; trend_following needs none.
TRADING_PAIRS=ADA/USDT,BTC/USDT,XRP/USDT,LINK/USDT
DEFAULT_TIMEFRAME=4h
STRATEGY=trend_following
# Total open risk cap across all positions (see PORTFOLIO_MAX_HEAT docs)
PORTFOLIO_MAX_HEAT=0.06
MAX_OPEN_POSITIONS=3
RISK_PER_TRADE=0.02
MAX_DRAWDOWN=0.10
PAPER_TRADING=true

# ═══════════════════════════════════════════
# News API (get free key at newsapi.org)
# ═══════════════════════════════════════════
NEWS_API_KEY=

# ═══════════════════════════════════════════
# Database
# ═══════════════════════════════════════════
DATABASE_URL=sqlite:///storage/neurontrade.db

# ═══════════════════════════════════════════
# Logging
# ═══════════════════════════════════════════
LOG_LEVEL=INFO
LOG_FILE=logs/neurontrade.log
